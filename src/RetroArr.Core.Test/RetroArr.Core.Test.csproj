<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <!-- Tests follow whatever dotnet runtime is installed on the dev host. Production
         assemblies stay on net8.0; this override only affects the test runner. -->
    <TargetFramework>$(DOTNET_TEST_TARGET_FRAMEWORK)</TargetFramework>
    <TargetFramework Condition="'$(TargetFramework)' == ''">net8.0</TargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.InMemory" Version="8.0.33" />
  </ItemGroup>

  <ItemGroup>
    <!-- Small real archives (locked RAR5 and 7z) the tests unpack -->
    <None Include="Fixtures\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\RetroArr.Core\RetroArr.Core.csproj" />
    <ProjectReference Include="..\RetroArr.Api.V3\RetroArr.Api.V3.csproj" />
  </ItemGroup>
</Project>
